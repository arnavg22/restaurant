# HTTP-only (no domain / no TLS) — for testing. Access via http://<elastic-ip>/
# When you have a real domain, replace ":80" with the domain (e.g. cafeteria.YOURDOMAIN.com)
# and Caddy will switch on automatic HTTPS.
# NOTE: set FRONTEND_URL=http://<elastic-ip> in backend/.env (or remove it) so the
# Socket.IO origin check accepts connections over plain HTTP.
:80 {
    encode zstd gzip

    # API + realtime WebSocket → Node backend
    @backend path /api/* /socket.io/*
    handle @backend {
        reverse_proxy app:3088
    }

    # Everything else → static frontend (pretty URLs: /customer -> customer.html)
    handle {
        root * /srv/frontend
        try_files {path} {path}.html /index.html
        file_server
    }
}
