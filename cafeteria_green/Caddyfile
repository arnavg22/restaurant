13-206-114-130.nip.io {
    encode zstd gzip

    # API + realtime WebSocket → Node backend
    @backend path /api/* /socket.io/*
    handle @backend {
        reverse_proxy app:3088
    }

    # Everything else → static frontend (pretty URLs: /customer -> customer.html)
    handle {
        root * /srv/frontend
        try_files {path} {path}.html /index.html
        file_server
    }
}
